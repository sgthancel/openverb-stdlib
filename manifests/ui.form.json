{
  "family": "ui.form",
  "version": "1.0.0",
  "verbs": [
    {
      "id": "ui.form.list",
      "version": "1.0.0",
      "summary": "List all registered forms on the current page or view.",
      "input": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "forms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Form identifier"
                },
                "title": {
                  "type": "string",
                  "description": "Human-readable form name"
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string",
                        "description": "Field type (text, email, number, select, etc.)"
                      },
                      "label": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "ui.form.fill",
      "version": "1.0.0",
      "summary": "Fill one or more fields in a form by id. Does not submit: fill, let the person see what was typed, then submit. Reports which fields were actually set, so a step can stop rather than carry on into an empty form.",
      "input": {
        "type": "object",
        "properties": {
          "formId": {
            "type": "string",
            "description": "Form identifier"
          },
          "values": {
            "type": "object",
            "description": "Key-value map of field names to values. Fills several fields at once."
          },
          "field": {
            "type": "string",
            "description": "A single field name, as an alternative to `values`. A walkthrough usually fills one field per step so there is something to say between them."
          },
          "value": {
            "type": "string",
            "description": "The value for `field`."
          }
        },
        "required": ["formId", "values"]
      },
      "output": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "filled": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The fields that were actually set."
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Fields that were asked for and not found. Claiming success for a field that does not exist is how a walkthrough ends up submitting an empty form with nothing saying why."
          }
        }
      }
    },
    {
      "id": "ui.form.submit",
      "version": "1.0.0",
      "summary": "Submit a form by id. Returns validation errors if the form is invalid.",
      "input": {
        "type": "object",
        "properties": {
          "formId": {
            "type": "string",
            "description": "Form identifier"
          }
        },
        "required": ["formId"]
      },
      "output": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            },
            "description": "Validation errors (empty if success)"
          }
        }
      }
    },
    {
      "id": "ui.form.reset",
      "version": "1.0.0",
      "summary": "Reset a form to its default values.",
      "input": {
        "type": "object",
        "properties": {
          "formId": {
            "type": "string",
            "description": "Form identifier"
          }
        },
        "required": ["formId"]
      },
      "output": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          }
        }
      }
    }
  ]
}
